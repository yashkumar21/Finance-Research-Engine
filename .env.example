# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Finnhub API key, free tier (https://finnhub.io/register), 60 calls/min limit
FINNHUB_API_KEY=your-finnhub-key-here

# Requesty key, used to call TypeSafe AI's Jev (https://app.requesty.ai/api-keys)
# Free tier: $5 of credits every 30 days. Do not buy credits - a purchase ends the free allowance.
REQUESTY_API_KEY=your-requesty-key-here
