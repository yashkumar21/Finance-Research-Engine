# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Finnhub API key, free tier (https://finnhub.io/register), 60 calls/min limit
FINNHUB_API_KEY=your-finnhub-key-here

# Vercel AI Gateway key, used to call TypeSafe AI's Jev (https://vercel.com/ai-gateway)
# Free tier: $5 of credits every 30 days. Do not buy credits - a purchase ends the free allowance.
AI_GATEWAY_API_KEY=your-ai-gateway-key-here
