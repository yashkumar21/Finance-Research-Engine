# Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Finnhub API key, free tier (https://finnhub.io/register), 60 calls/min limit
FINNHUB_API_KEY=your-finnhub-key-here

# TypeSafe API key, used to call Jev (https://docs.typesafe.ai). Paid credits required;
# the project uses ~$0.04 per 100 tickers screened.
TYPESAFE_API_KEY=your-typesafe-key-here
